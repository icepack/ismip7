#!/bin/bash

#SBATCH -J ant_timing_inv
#SBATCH -p general
#SBATCH -o ant_timing_inv%j.txt
#SBATCH -e ant_timing_inv%j.err
#SBATCH --mail-type=ALL
#SBATCH --mail-user=dlilien@iu.edu
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=12
#SBATCH --time=48:00:00
#SBATCH --mem=128G
#SBATCH -A r00905

#Load any modules that your program needs
module use /N/u/dlilien/Quartz/modulefiles
module load gnu/9.3.0
module load openmpi/4.0.5
module load python/3.14.5
module load zlib/1.2.13
module load hdf5/1.12
module load openblas/0.3.13
module load patchelf/0.18.0
module load petsc/3.25.5
module load firedrake/2026.04
. /N/u/dlilien/Quartz/sw/firedrake/2026.04/firedrake/bin/activate

cd "${SLURM_SUBMIT_DIR:-.}"

# The Makefile supplies these values with sbatch --export. Keep defaults here
# too so the script remains directly runnable from Quartz.
export ISMIP7_LC="${ISMIP7_LC:-2500}"
export ISMIP7_LC_COARSE="${ISMIP7_LC_COARSE:-25000}"
export ISMIP7_BUFFER_M="${ISMIP7_BUFFER_M:-20000}"
export ISMIP7_FRICTION="${ISMIP7_FRICTION:-budd}"
export ISMIP7_N_FLOW="${ISMIP7_N_FLOW:-3.0}"
export ISMIP7_A4_FACTOR="${ISMIP7_A4_FACTOR:-1.0}"

srun -n "${SLURM_NTASKS}" python -u scripts/inversion_icepack2.py
