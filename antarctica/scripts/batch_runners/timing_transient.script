#!/bin/bash

#SBATCH -J ant_timing
#SBATCH -p general
#SBATCH -o ant_timing_%j.txt
#SBATCH -e ant_timing_%j.err
#SBATCH --mail-type=ALL
#SBATCH --mail-user=dlilien@iu.edu
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=16
#SBATCH --time=12:00:00
#SBATCH --mem=128G
#SBATCH -A r00905

#Load any modules that your program needs
module use /N/u/dlilien/Quartz/modulefiles
module load gnu/9.3.0
module load openmpi/4.0.5
module load python/3.14.5
module load zlib/1.2.13
module load hdf5/1.12
module load openblas/0.3.13
module load patchelf/0.18.0
module load petsc/3.25.5
module load firedrake/2026.04
. /N/u/dlilien/Quartz/sw/firedrake/2026.04/firedrake/bin/activate

export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1

cd "${SLURM_SUBMIT_DIR:-.}"

# ISMIP7_LC, ISMIP7_LC_COARSE, ISMIP7_BUFFER_M, ISMIP7_INVERSION,
# ISMIP7_T_END, ISMIP7_DT, and ISMIP7_TIMING_STATUS are forwarded via
# sbatch --export=ALL,... . The
# Makefile overrides --mem per resolution; 128G is the safe standalone default
# for the finest 500 m timing case.
write_status() {
    if [ -n "${ISMIP7_TIMING_STATUS:-}" ]; then
        status_tmp="${ISMIP7_TIMING_STATUS}.tmp.${SLURM_JOB_ID:-$$}"
        printf '%s job_id=%s timestamp=%s\n' \
            "$1" "${SLURM_JOB_ID:-unknown}" "$2" > "${status_tmp}"
        mv -f "${status_tmp}" "${ISMIP7_TIMING_STATUS}"
    fi
}

write_status running "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
set +e
srun -n ${SLURM_NTASKS} python -u scripts/run_timing.py
run_rc=$?
set -e
if [ ${run_rc} -eq 0 ]; then
    write_status "finished exit_code=0" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
else
    write_status "failed exit_code=${run_rc}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
fi
exit ${run_rc}
