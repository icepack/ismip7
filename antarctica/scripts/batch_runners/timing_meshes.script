#!/bin/bash

# Build the timing-matrix meshes in a short, single-rank Quartz allocation.

#SBATCH -J ant_timing_mesh
#SBATCH -p general
#SBATCH -o ant_timing_mesh%j.txt
#SBATCH -e ant_timing_mesh%j.err
#SBATCH --mail-type=ALL
#SBATCH --mail-user=dlilien@iu.edu
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --time=08:00:00
#SBATCH --mem=32G
#SBATCH -A r00905

module use /N/u/dlilien/Quartz/modulefiles
module load gnu/9.3.0
module load openmpi/4.0.5
module load python/3.14.5
module load zlib/1.2.13
module load hdf5/1.12
module load openblas/0.3.13
module load patchelf/0.18.0
module load petsc/3.25.5
module load firedrake/2026.04
. /N/u/dlilien/Quartz/sw/firedrake/2026.04/firedrake/bin/activate

cd "${SLURM_SUBMIT_DIR:-.}"

IFS=: read -ra lcs <<< "${TIMING_LCS:-500:1000:2000:2500:5000}"
IFS=: read -ra ratios <<< "${TIMING_RATIOS:-20:10}"
buffer="${TIMING_BUFFER:-20000}"

for lc in "${lcs[@]}"; do
  for ratio in "${ratios[@]}"; do
    lc_coarse=$((lc * ratio))
    mesh="mesh/antarctica_${lc_coarse}_${lc}_buffered${buffer}.msh"
    bndids="mesh/boundary_ids_antarctica_${lc_coarse}_${lc}_buffered${buffer}.json"
    if [ -f "${mesh}" ] && [ -f "${bndids}" ]; then
      echo "skip ${mesh}"
      continue
    fi
    python -u scripts/mesh_antarctica.py \
      --lc "${lc}" --lc-coarse "${lc_coarse}" --buffer-m "${buffer}"
  done
done
