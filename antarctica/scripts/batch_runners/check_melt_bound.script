#!/bin/bash

# scripts/check_melt_bound.py as a job. It melts the reference geometry with
# the forward's own callback and sets the melt, per IMBIE2 basin, against the
# totals the melt calibration was fitted to (issue 30), and with --ocx it is
# the tripwire core 11 needs before it runs on the ISMIP7 OCX product (issue
# #11): the forward half melted with the OCX ocean, set against the
# climatology the calibration was fitted to, per IMBIE2 basin and per 256 km
# block. Serial. The job ends with the check's own status, 0 clean and 1 when
# any basin misses its calibration or any basin or block is flagged in any
# year, so sacct carries the verdict.
#
# From antarctica/ (measured on Quartz, September 2026: 1 min and under 1 GB on
# a 2500 m mesh, 4 min and 5 GB on the 1000 m production mesh):
#
#   scripts/batch_runners/submit.sh script scripts/batch_runners/check_melt_bound.script \
#       --cd antarctica --queue debug --tasks 1 --mem 16G --time 00:30:00 \
#       ISMIP7_INV_H5=$PWD/mesh/<map>.h5
#
# ISMIP7_INV_H5 supplies the mesh and nothing else, so a forward state serves
# where no MAP exists yet at that resolution:
#
#       ISMIP7_INV_H5=$PWD/results/<run>_1000_final.h5
#
# The calibration is the one a forward reads: the tracked
# calibration/deltaT_per_basin_1000_K6.500e-05.npz, unless
# ISMIP7_DELTAT_PER_BASIN_NPZ names offsets or ISMIP7_K_PER_BASIN_NPZ a legacy
# per-basin K. ISMIP7_OCX_OCEAN picks the OCX variant (main), and `none` skips
# the OCX comparison. The log carries the forcing-provenance lines, which say
# which calibration and which OCX version the check read: record them with
# the verdict, since upstream replaces these files.

#SBATCH -o ant_melt_bound_%j.txt
#SBATCH -e ant_melt_bound_%j.err

# Resources, the account and the partition come from submit.sh, which reads
# this cluster's sites/<name>.sh; nothing here names a cluster.
cd "${SLURM_SUBMIT_DIR:-.}"
# The site half only: every model setting arrives through --export, and
# site_env.sh's defaults (ISMIP7_LC=1000, ISMIP7_FRICTION) are not this job's.
. scripts/batch_runners/site_core.sh
ismip7_activate
ismip7_persistent_jit_cache
ismip7_banner

h5="${ISMIP7_INV_H5:?ISMIP7_INV_H5 is required (a MAP or a forward state, read for its mesh)}"
[ -f "${h5}" ] || { echo "mesh source not found: ${h5}" >&2; exit 2; }
if [ -n "${ISMIP7_DELTAT_PER_BASIN_NPZ:-}" ] && [ -n "${ISMIP7_K_PER_BASIN_NPZ:-}" ]; then
    echo "ISMIP7_DELTAT_PER_BASIN_NPZ and ISMIP7_K_PER_BASIN_NPZ are both set; name one calibration" >&2
    exit 2
fi

args=()
[ "${ISMIP7_OCX_OCEAN:-main}" = none ] || args+=(--ocx "${ISMIP7_OCX_OCEAN:-main}")
npz="${ISMIP7_DELTAT_PER_BASIN_NPZ:-${ISMIP7_K_PER_BASIN_NPZ:-}}"
if [ -n "${npz}" ]; then
    [ -f "${npz}" ] || { echo "melt calibration not found: ${npz}" >&2; exit 2; }
    args+=(--npz "${npz}")
    echo "    melt    ${npz}  sha256 $({ sha256sum "${npz}" 2>/dev/null || shasum -a 256 "${npz}"; } | cut -d' ' -f1)"
fi
echo "    commit  $(git rev-parse --short HEAD 2>/dev/null || echo unknown)"

# site_core.sh sets -u, under which bash before 4.4 calls an empty array
# unbound; this form expands to nothing there.
python -u scripts/check_melt_bound.py ${args[@]+"${args[@]}"}
status=$?
echo "check_melt_bound exit status: ${status}"
exit "${status}"
