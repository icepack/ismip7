#!/bin/bash

# Rewrite the shared timing MAP with a one-rank allocation so all transient
# jobs can load it with their own MPI size.

#SBATCH -J ant_timing_redist
#SBATCH -p general
#SBATCH -o ant_timing_redist%j.txt
#SBATCH -e ant_timing_redist%j.err
#SBATCH --mail-type=ALL
#SBATCH --mail-user=dlilien@iu.edu
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --time=01:00:00
#SBATCH --mem=16G
#SBATCH -A r00905

module use /N/u/dlilien/Quartz/modulefiles
module load gnu/9.3.0
module load openmpi/4.0.5
module load python/3.12.4
module load zlib/1.2.13
module load hdf5/1.12
module load openblas/0.3.13
module load patchelf/0.18.0
module load petsc/3.24.0
module load firedrake/2025.10
. /N/u/dlilien/Quartz/sw/firedrake/2025.10/firedrake/bin/activate

cd "${SLURM_SUBMIT_DIR:-.}"

input="${TIMING_INV_CHK:-mesh/inversion_icepack2_budd_n3_2500.h5}"
srun -n 1 python -u scripts/redistribute_checkpoint.py \
  --input "${input}" --output "${input}"
